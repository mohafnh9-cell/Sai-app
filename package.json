{
  "name": "sequrai-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run",
    "test:release": "vitest run --exclude 'brain/evidence-finding/__tests__/evidence-finding.test.ts' --exclude 'features/security-scanner/__tests__/api-routes-auth-audit.test.ts' --exclude 'features/security-testing/__tests__/live-test-copy.test.ts' --exclude 'lib/env/__tests__/scan-scheduler.test.ts' --exclude 'server/ai-red-team/**' --exclude 'server/attack-simulation/__tests__/attack-center-api.test.ts' --exclude 'server/attack-simulation/__tests__/mvp-adapters.test.ts' --exclude 'server/jobs/**' --exclude 'server/mcp/__tests__/review-now.test.ts' --exclude 'server/review-now/__tests__/trigger-review-stale.test.ts' --exclude 'server/security-alerts/**' --exclude 'server/platform-convergence/__tests__/convergence-snapshots.test.ts'",
    "test:security-scanner": "vitest run features/security-scanner",
    "dev:inngest": "npx inngest-cli dev",
    "validate:env": "node scripts/validate-env.mjs",
    "validate:env:production": "node scripts/validate-env.mjs --production",
    "validate:env:staging": "node scripts/validate-env.mjs --staging",
    "release:verify": "node scripts/local-release-verify.mjs",
    "validate:schema": "node scripts/schema-health-check.mjs",
    "validate:rls": "node scripts/validate-rls-rpc.mjs",
    "validate:phase1-staging": "node scripts/staging-validate-phase1.mjs",
    "validate:phase1-6": "node scripts/staging-validate-phase1-6.mjs",
    "validate:migrations": "node scripts/migration-preflight.mjs",
    "validate:red-team": "node scripts/validate-red-team.mjs",
    "validate:platform-e2e": "vitest run server/ai-red-team/e2e-validation",
    "validate:platform-convergence": "vitest run server/platform-convergence",
    "validate:platform-convergence:staging": "node scripts/validate-platform-convergence-staging.mjs",
    "validate:platform-convergence:main": "node scripts/validate-platform-convergence-main.mjs",
    "validate:threat-model": "vitest run server/ai-red-team/threat-model",
    "load-test:staging": "node scripts/staging-load-test.mjs",
    "db:apply-migrations": "node scripts/apply-migrations.mjs",
    "mcp": "node mcp/stdio-bridge.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-accordion": "^1.2.16",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-collapsible": "^1.1.16",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-progress": "^1.1.12",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-toast": "^1.2.19",
    "@stripe/stripe-js": "^9.9.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.1",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@types/pg": "^8.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "inngest": "^3.54.2",
    "lucide-react": "^1.23.0",
    "nanoid": "^5.1.16",
    "next": "^16.2.10",
    "next-themes": "^0.4.6",
    "openai": "^6.45.0",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "resend": "^6.17.1",
    "server-only": "^0.0.1",
    "stripe": "^22.3.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "playwright": "^1.52.0"
  }
}

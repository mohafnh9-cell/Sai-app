# SequrAI — environment variables (no secrets)
# Copy to .env.local and fill in values from Supabase / GitHub / Vercel.

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional product documentation URL (shown in Workspace Switcher when set)
# NEXT_PUBLIC_DOCS_URL=https://docs.sequrai.com

# ─── Supabase (required) ────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── GitHub (required for Continuous Reviews in production) ───────────────────
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here
# Optional override for webhook URL registration
# GITHUB_WEBHOOK_URL=https://your-domain.com/api/webhooks/github

# Encrypt GitHub OAuth tokens at rest (recommended for private beta)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# GITHUB_TOKEN_ENCRYPTION_KEY=

# ─── AI (optional — AI summaries degrade gracefully without it) ───────────────
# ANTHROPIC_API_KEY=

# ─── Email (optional) ───────────────────────────────────────────────────────
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=noreply@yourdomain.com

# ─── Stripe (optional — billing not required for Builder Edition beta) ───────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_BUILDER_PRICE_ID=
# STRIPE_STUDIO_PRICE_ID=
# STRIPE_AGENCY_PRICE_ID=

# ─── Development only — NEVER set in production ─────────────────────────────
# SEQURAI_BYPASS_AUTH=false
# Unlimited manual scans + MCP review_now during private beta (default on Vercel production).
# Before public launch, set SCAN_RATE_LIMIT_ENABLED=1 (5 web / 10 MCP per hour unless overridden).
# SCAN_RATE_LIMIT_DISABLED=1
# SCAN_RATE_LIMIT_ENABLED=1
# WEB_SCANS_PER_REPOSITORY_PER_HOUR=5
# MCP_REVIEWS_PER_ORGANIZATION_PER_HOUR=10

# ─── Async scan orchestration (Phase 1) ───────────────────────────────────
# SCAN_SCHEDULER=inline
# SCAN_SCHEDULER=inngest
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# ─── Phase 1.5 operations ───────────────────────────────────────────────────
# INTERNAL_OPS_TOKEN=
# SCAN_JOB_QUEUE_STALE_MINUTES=10
# SCAN_JOB_RECOVERY_MAX_ATTEMPTS=3
# OPS_ALERT_WEBHOOK_URL=
# LOAD_TEST_CONFIRM=no

# ─── Phase 1.6 staging / progressive cutover ───────────────────────────────
# STAGING_BASE_URL=https://staging.example.com
# STAGING_TEST_ORG_ID=
# INNGEST_ASYNC_ORG_ALLOWLIST=
# LOAD_TEST_ALLOW_LOCALHOST=false

# ─── Sprint 8 — production readiness (internal) ─────────────────────────────
# SEQURAI_FEATURE_FLAGS_JSON={"inngest_scheduler":"private_beta"}
# SEQURAI_BETA_ORG_IDS=
# SEQURAI_INTERNAL_ORG_IDS=
# SEQURAI_COST_REVIEW_USD=0.35
# SEQURAI_COST_SAFE_FIX_USD=0.08
# SEQURAI_COST_REPORT_USD=0.02

# ─── Dynamic security lab ───────────────────────────────────────────────────
# LOCAL (Node lab on 127.0.0.1 — dev/tests only):
# SEQURAI_DYNAMIC_LAB_ORIGIN=http://127.0.0.1:<port>
#
# REMOTE dedicated lab Vercel project (Preview/Staging only):
# SEQURAI_SECURITY_LAB_ENABLED=true
# SEQURAI_LAB_IDOR_PROTECTED=0
# SEQURAI_LAB_WEBHOOK_UNPROTECTED=0
# SEQURAI_LAB_MASS_ASSIGNMENT_PROTECTED=0
# SEQURAI_LAB_PRIVILEGE_ESCALATION_VULNERABLE=0
# SEQURAI_LAB_INJECTION_PROTECTED=0
# SEQURAI_LAB_SSRF_VULNERABLE=1
# SEQURAI_LAB_CORS_PROTECTED=0
# SEQURAI_LAB_WEBHOOK_SECRET=
#
# SequrAI app (production/preview) — authorize remote lab via DB, NOT via SEQURAI_DYNAMIC_LAB_ORIGIN:
# SEQURAI_STAGING_LAB_ORIGIN=https://<your-lab-host>.vercel.app
# SEQURAI_STAGING_LAB_ORG_ID=
# SEQURAI_STAGING_LAB_PROJECT_ID=
#
# Opt-in remote HTTPS integration tests:
# SEQURAI_REMOTE_DYNAMIC_LAB_ORIGIN=https://<your-lab-host>.vercel.app
#
# NEVER enable in production:
# SEQURAI_PRODUCTION_DYNAMIC_ENABLED=true
